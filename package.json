{
  "name": "boring-table-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "coverage": "vitest run --coverage",
    "audit": "pnpm audit",
    "lint": "oxlint . --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix --report-unused-disable-directives",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:package",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.14",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.7.0"
}
