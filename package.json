{
  "name": "boring-table-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --concurrency 2",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "coverage": "turbo run coverage",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=docs^... && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@microsoft/api-extractor": "^7.55.2",
    "@types/node": "^20.19.27",
    "@vitest/coverage-v8": "^1.6.1",
    "rimraf": "^5.0.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^1.13.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
