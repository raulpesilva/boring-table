{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/.next/**",
    "**/.output/**",
    "**/.source/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    ".idea/**",
    "assets/**",
    "docs/next-env.d.ts",
    "docs/package-lock.json",
    "docs/public/**",
    "docs/src/routeTree.gen.ts",
    "jean.json",
    "pnpm-lock.yaml"
  ],
  "jsxSingleQuote": true,
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5"
}
